# Copy to .env and fill in. Never commit .env.
# Names are case-insensitive (groq_api_key and GROQ_API_KEY both work).

# --- General ---
LOG_LEVEL=INFO

# --- Database ---
# Local: the compose `db` service. Production: Supabase (EU region) on port 5432
# (direct or session connection), never the 6543 transaction pooler.
DATABASE_URL=postgresql+asyncpg://intake:intake@localhost:5432/intake

# --- Models (primary: Groq, secondary: OpenRouter) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=60
# Paid prices per million tokens, used for Estimated Cost (JSON). Defaults live in
# app/core/config.py; override only if prices change.
# MODEL_PRICES={"openai/gpt-oss-120b": {"input_per_mtok": 0.15, "output_per_mtok": 0.60}}

# --- Hermes gateway (on the host) ---
# false = call the models directly through LLMClient (escape hatch, ADR 0001).
HERMES_ENABLED=true
HERMES_BASE_URL=http://127.0.0.1:8643
HERMES_API_KEY=
HERMES_TIMEOUT_SECONDS=60

# --- Slack Approval (leave the token empty to skip posting) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_SIGNATURE_MAX_AGE_SECONDS=300
# Dashboard base URL; the Slack message links to the Intake there (empty: no link).
DASHBOARD_URL=

# --- API surface ---
# Required in the X-API-Key header for POST /intakes.
INTAKE_API_KEY=
# Comma-separated dashboard origins (Vercel + local Vite dev server).
CORS_ORIGINS=http://localhost:5173
