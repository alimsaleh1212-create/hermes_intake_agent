# TEMPLATE unit for the Intake service's OWN Hermes gateway (127.0.0.1:8643).
# It runs from a dedicated Hermes home (__HOME__/.hermes-intake), so it never
# shares config, .env, skills or port with a personal Hermes in ~/.hermes.
# The setup wizard writes a user-service version of this file to
# ~/.config/systemd/user/hermes-intake-gateway.service. For a system-wide install,
# copy it to /etc/systemd/system/ and replace __SERVICE_USER__ with the non-root
# user that ran the Hermes installer and __HOME__ with that user's home directory
# (the binary is __HOME__/.local/bin/hermes). Do NOT add an ExecStopPost kill -9.
# HERMES_HOME selects the home; the port and key come from that home's .env.
[Unit]
Description=Hermes Agent gateway for Intake (API server on 127.0.0.1:8643)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__HOME__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_HOME=__HOME__/.hermes-intake
ExecStart=__HOME__/.local/bin/hermes gateway run
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
